{
  "name": "facial-auth-backend",
  "version": "1.0.0",
  "description": "Sistema completo de autenticación biométrica facial - Backend API con PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "mocha tests/**/*.test.js --timeout 10000 --recursive",
    "test:auth": "mocha tests/auth.test.js --timeout 10000",
    "test:user": "mocha tests/user.test.js --timeout 10000",
    "test:dashboard": "mocha tests/dashboard.test.js --timeout 10000",
    "test:roles": "mocha tests/roles.test.js --timeout 10000",
    "test:security": "mocha tests/security.test.js --timeout 10000",
    "test:integration": "mocha tests/integration.test.js --timeout 15000",
    "test:watch": "mocha tests/**/*.test.js --timeout 10000 --recursive --watch",
    "test:coverage": "nyc mocha tests/**/*.test.js --timeout 10000 --recursive",
    "test:jwt": "node tests/jwt-test.js",
    "test:quick": "mocha tests/auth.test.js tests/user.test.js --timeout 5000",
    "test:full": "npm run test:auth && npm run test:user && npm run test:dashboard && npm run test:roles && npm run test:security && npm run test:integration",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "backup": "node scripts/backup.js"
  },
  "keywords": [
    "facial-recognition",
    "biometric-auth",
    "express",
    "postgresql",
    "neon",
    "jwt",
    "bcrypt",
    "authentication",
    "swagger",
    "openapi"
  ],
  "author": "Sistema Biométrico Auth",
  "license": "MIT",
  "dependencies": {
    "@mono-repo/shared-middleware": "file:../shared/middleware-package",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "chai": "^4.5.0",
    "jest": "^29.7.0",
    "mocha": "^10.8.2",
    "nodemon": "^3.0.2",
    "nyc": "^15.1.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/facial-auth/backend.git"
  },
  "bugs": {
    "url": "https://github.com/facial-auth/backend/issues"
  },
  "homepage": "https://github.com/facial-auth/backend#readme"
}